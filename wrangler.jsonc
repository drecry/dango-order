{
  // Cloudflare Workers Static Assets config for Dango Order.
  // Serves only this game, under drecry.com/dango-order/ via the routes below,
  // mirroring Dango Drop. See docs/deployment.md.
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration.schema.json",
  "name": "dango-order",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "drecry.com/dango-order*",
      "zone_name": "drecry.com"
    },
    {
      "pattern": "www.drecry.com/dango-order*",
      "zone_name": "drecry.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
